# ============================================================================
# Ark Seed MCP: single-organization self-hosted configuration
#
# Copy to .env (never commit it) and fill in every REQUIRED value.
# Transport, host allowlist, proxy trust, and the job backend URL are
# pinned in compose.yaml and cannot be overridden here.
# Full reference: docs/self-hosting.md and docs/configuration.md
# ============================================================================

# --- Public endpoint (REQUIRED) ---------------------------------------------
# DNS name clients connect to. Caddy serves https://<MCP_PUBLIC_HOST>/mcp
MCP_PUBLIC_HOST=mcp.example.com

# Browser origins allowed to call the server. Leave empty for desktop and CLI
# MCP clients, which send no Origin header. Comma-separated https URLs.
MCP_ALLOWED_ORIGINS=

# --- MCP client authentication ---------------------------------------------
# One shared team identity, budget, concurrency limit, and data access.
# Never use a BytePlus provider key as the MCP bearer key.
MCP_AUTH_MODE=api_key
# REQUIRED. Generate with scripts/generate_mcp_key.py.
# Store only its emitted hash here; distribute the private key file securely.
MCP_API_KEY_SHA256=

# --- BytePlus credentials (set only the products you use) -------------------
# Tools for a product register only when its key is present.
BYTEPLUS_MODELARK_API_KEY=
BYTEPLUS_SEED_SPEECH_API_KEY=
BYTEPLUS_VOD_MEDIAKIT_API_KEY=
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_SEED_AUDIO_BASE_URL=https://voice.ap-southeast-1.bytepluses.com

# Live model pricing and private asset library (ark_asset_*). These IAM keys act on the WHOLE BytePlus
# account and the tools include real-person verification. Leave empty unless
# you need them, and grant explicit asset scopes to administrators only.
BYTEPLUS_MODELARK_ACCESS_KEY=
BYTEPLUS_MODELARK_SECRET_KEY=
BYTEPLUS_MODELARK_SESSION_TOKEN=
BYTEPLUS_MODELARK_PRICING_REFRESH_SECONDS=86400

# --- Spend and abuse guardrails (REQUIRED for shared use) -------------------
# Per-principal UTC daily cap in USD (whole team in api_key mode).
# 0 only records spend and never blocks.
DAILY_BUDGET_USD=25
# Requests per minute per client IP, and the burst allowance.
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
# Concurrent billable calls per provider and per principal (whole team in api_key).
# Raise PROVIDER_MAX_CONCURRENCY to match your BytePlus account quota.
PROVIDER_MAX_CONCURRENCY=5
PRINCIPAL_MAX_CONCURRENCY=3

# --- Background jobs (REQUIRED) ---------------------------------------------
# Generate each with: openssl rand -hex 32
# REDIS_PASSWORD must stay URL-safe (hex is). Keep FASTMCP_TASKS_ENCRYPTION_KEY
# stable: changing it makes retained job snapshots unreadable.
REDIS_PASSWORD=
FASTMCP_TASKS_ENCRYPTION_KEY=

# --- Artifact storage -------------------------------------------------------
# filesystem: stored in the ark-state volume (works out of the box).
# object_storage: recommended for heavy video use; needs TOS_* or S3_* below.
ARTIFACT_BACKEND=filesystem
ARTIFACT_TTL_SECONDS=604800
# OBJECT_STORAGE_BACKEND=tos
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=
# TOS_BUCKET=
# TOS_REGION=ap-southeast-1

# --- Logging ----------------------------------------------------------------
ARK_LOG_LEVEL=INFO
