[Unit]
Description=Ark MCP single-organization stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/ark-mcp

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ark-mcp
UMask=0077
ExecStartPre=/usr/bin/mountpoint -q /srv/ark-mcp
ExecStartPre=/usr/bin/python3 /opt/ark-mcp/check_env.py /srv/ark-mcp/config/.env
ExecStart=/usr/bin/docker compose --env-file /srv/ark-mcp/config/.env -f /opt/ark-mcp/compose.yaml up -d --no-build --wait --wait-timeout 240
ExecStop=/usr/bin/docker compose --env-file /srv/ark-mcp/config/.env -f /opt/ark-mcp/compose.yaml stop --timeout 660
TimeoutStartSec=900
TimeoutStopSec=720

[Install]
WantedBy=multi-user.target
