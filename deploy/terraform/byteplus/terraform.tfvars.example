admin_cidrs        = ["203.0.113.10/32"]
https_cidrs        = ["0.0.0.0/0"]
data_disk_size_gib = 100
volume_type       = "ESSD_PL0"
eip_bandwidth_mbps = 20

instance_deletion_protection = true
