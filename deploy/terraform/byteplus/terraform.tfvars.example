region        = "ap-southeast-1"
zone_id       = "ap-southeast-1a"
name          = "ark-mcp-team"
project_name  = "default"
image_id      = "image-REPLACE-WITH-UBUNTU-2404-AMD64"
instance_type = "ecs.g4i.large"
key_pair_name = "REPLACE-WITH-EXISTING-KEYPAIR"

public_hostname = "mcp.example.com"
